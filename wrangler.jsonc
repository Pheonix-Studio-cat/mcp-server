{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-mcp-server",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  }

  // Optional: Bindings, sobald du sie brauchst.
  // KV zuerst anlegen:  npx wrangler kv namespace create NOTES
  // "kv_namespaces": [
  //   { "binding": "NOTES", "id": "<DEINE_KV_ID>" }
  // ]
}
